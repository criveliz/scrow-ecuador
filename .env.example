# Environment Variables Example for Escrow Ecuador

# Database Configuration
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=escrow_db
POSTGRES_USER=escrow_user
POSTGRES_PASSWORD=escrow_password
DATABASE_URL=postgresql://escrow_user:escrow_password@localhost:5432/escrow_db

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Application
NODE_ENV=development
PORT=3000
JWT_SECRET=super-secret-development-jwt-key
